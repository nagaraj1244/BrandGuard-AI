{
  "name": "brandguard-ai",
  "version": "1.0.0",
  "description": "BrandGuard AI – Intelligent Brand Governance Platform based on Inkloom AI problem statement",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "build": "echo 'Ready for cloud deployment'",
    "start": "node server/src/index.js",
    "tunnel": "npx -y localtunnel --port 5000"
  },
  "keywords": [
    "brand-governance",
    "ai-compliance",
    "brandguard",
    "inkloom-ai"
  ],
  "author": "BrandGuard Team",
  "license": "MIT"
}

